<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dlss5Suite.Setup.Views.SetupWindow"
        Width="760" Height="560"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Icon="/Assets/logo.ico"
        Title="DLSS 5 SUITE Setup">

  <Border CornerRadius="18" ClipToBounds="True" Background="#080D0A"
          BorderThickness="1" BorderBrush="#1CFFFFFF">
    <Panel>
      <!-- The same backdrop the application uses, so the setup reads as the
           first screen of the product rather than a separate utility. -->
      <Image Source="/Assets/bg_nebula.jpg" Stretch="UniformToFill" Opacity="0.5" />
      <Border Background="#66000000" />

      <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============================== TITLE BAR ============================== -->
        <Grid Grid.Row="0" x:Name="TitleBar" ColumnDefinitions="*,Auto" Height="46" Background="#01FFFFFF">
          <TextBlock Grid.Column="0" Text="DLSS 5 SUITE Setup" VerticalAlignment="Center"
                     Margin="20,0,0,0" FontSize="12.5" Foreground="#94A3B8" />
          <Button Grid.Column="1" x:Name="CloseButton" Classes="Close" Content="✕"
                  Margin="0,0,10,0" VerticalAlignment="Center" />
        </Grid>

        <!-- ================================ PAGES ================================ -->
        <Panel Grid.Row="1" Margin="40,6,40,0">

          <!-- 0. WELCOME -->
          <StackPanel x:Name="PageWelcome" Spacing="18">
            <Image Source="/Assets/logo.png" Height="74" HorizontalAlignment="Left"
                   Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />

            <StackPanel Spacing="6">
              <TextBlock x:Name="WelcomeHeading" Classes="H1" Text="Install DLSS 5 SUITE" />
              <TextBlock x:Name="WelcomeSub" Classes="Sub"
                         Text="Version 1.2.1-suite.4 — built by Potatoes9411, published by Potatoes-dev." />
              <TextBlock Classes="Sub" FontSize="12"
                         Text="A modified version of DLSS 5 MANAGER, built by NODIX TECH and published by Numidia Studios." />
            </StackPanel>

            <TextBlock Classes="Body" Text="Who should this be installed for?" Margin="0,4,0,0" />

            <StackPanel Spacing="10">
              <RadioButton x:Name="ScopeCurrentUser" Classes="Card" GroupName="Scope" IsChecked="True">
                <StackPanel Spacing="3">
                  <TextBlock Text="Just me" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F7" />
                  <TextBlock Classes="Sub" Text="Installs into your own profile. No administrator prompt." />
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="ScopeAllUsers" Classes="Card" GroupName="Scope">
                <StackPanel Spacing="3">
                  <TextBlock Text="All users on this PC" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F7" />
                  <TextBlock Classes="Sub" Text="Installs into Program Files. Needs administrator rights." />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </StackPanel>

          <!-- 1. LOCATION -->
          <StackPanel x:Name="PageLocation" Spacing="16" IsVisible="False">
            <StackPanel Spacing="6">
              <TextBlock Classes="H1" Text="Where should it go?" />
              <TextBlock Classes="Sub" Text="The application and its mod payload are installed into this folder." />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <TextBox Grid.Column="0" x:Name="PathBox" />
              <Button Grid.Column="1" x:Name="BrowseButton" Classes="Ghost" Content="Browse…" Margin="10,0,0,0" />
            </Grid>

            <Border x:Name="ElevationNotice" CornerRadius="12" Padding="14,12" IsVisible="False"
                    Background="#1A35D22B" BorderBrush="#4035D22B" BorderThickness="1">
              <TextBlock Classes="Body" x:Name="ElevationNoticeText"
                         Text="This folder needs administrator rights. Windows will ask once when the install starts, and the setup carries on from here." />
            </Border>

            <Border x:Name="SpaceNotice" CornerRadius="12" Padding="14,12" IsVisible="False"
                    Background="#1AFF453A" BorderBrush="#40FF453A" BorderThickness="1">
              <TextBlock Classes="Body" x:Name="SpaceNoticeText" Foreground="#FFC9C4" />
            </Border>

            <TextBlock x:Name="SpaceText" Classes="Sub" />
          </StackPanel>

          <!-- 2. OPTIONS -->
          <StackPanel x:Name="PageOptions" Spacing="16" IsVisible="False">
            <StackPanel Spacing="6">
              <TextBlock Classes="H1" Text="A few extras" />
              <TextBlock Classes="Sub" Text="All optional, and all changeable later." />
            </StackPanel>

            <StackPanel Spacing="14" Margin="0,6,0,0">
              <CheckBox x:Name="OptDesktop" Content="Create a desktop shortcut" IsChecked="True" />
              <CheckBox x:Name="OptStartMenu" Content="Add it to the Start menu" IsChecked="True" />
              <CheckBox x:Name="OptTaskbar" Content="Pin it to the taskbar" />
              <CheckBox x:Name="OptStartup" Content="Start it when Windows starts" />
            </StackPanel>

            <Border CornerRadius="12" Padding="14,12" Background="#12FFFFFF"
                    BorderBrush="#20FFFFFF" BorderThickness="1">
              <TextBlock Classes="Sub"
                         Text="Windows decides the taskbar pin, not the setup. Ticking this asks it to — Windows shows its own prompt during the install and pins it only if you agree." />
            </Border>
          </StackPanel>

          <!-- 3. PROGRESS -->
          <StackPanel x:Name="PageProgress" Spacing="18" IsVisible="False" VerticalAlignment="Center">
            <StackPanel Spacing="6">
              <TextBlock x:Name="ProgressHeading" Classes="H1" Text="Installing…" />
              <TextBlock x:Name="ProgressStatus" Classes="Sub" Text="Preparing…" />
            </StackPanel>

            <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Value="0" />

            <!-- Shown when the application is running and holding its own
                 files open. The install cannot proceed past this. -->
            <Border x:Name="RunningNotice" CornerRadius="14" Padding="18,16" IsVisible="False"
                    Background="#1AFF453A" BorderBrush="#50FF453A" BorderThickness="1">
              <StackPanel Spacing="14">
                <TextBlock Classes="Body" Foreground="#FFD9D6" x:Name="RunningText"
                           Text="DLSS 5 SUITE is currently running, and Windows will not let its files be replaced while it is open." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="CloseAndRetryButton" Classes="Primary" Content="Close it and retry" />
                  <Button x:Name="RetryButton" Classes="Ghost" Content="I closed it — retry" />
                  <Button x:Name="CancelInstallButton" Classes="Ghost" Content="Cancel" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="ErrorNotice" CornerRadius="14" Padding="18,16" IsVisible="False"
                    Background="#1AFF453A" BorderBrush="#50FF453A" BorderThickness="1">
              <StackPanel Spacing="14">
                <TextBlock x:Name="ErrorText" Classes="Body" Foreground="#FFD9D6" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="ErrorRetryButton" Classes="Primary" Content="Try again" />
                  <Button x:Name="ErrorCloseButton" Classes="Ghost" Content="Close" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 4. FINISH -->
          <StackPanel x:Name="PageFinish" Spacing="18" IsVisible="False">
            <Image Source="/Assets/logo.png" Height="66" HorizontalAlignment="Left"
                   Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />

            <StackPanel Spacing="6">
              <TextBlock x:Name="FinishHeading" Classes="H1" Text="All done" />
              <TextBlock x:Name="FinishSub" Classes="Sub" />
            </StackPanel>

            <Border x:Name="PinWarning" CornerRadius="12" Padding="14,12" IsVisible="False"
                    Background="#14FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
              <TextBlock x:Name="PinWarningText" Classes="Sub" />
            </Border>

            <StackPanel Spacing="14" Margin="0,4,0,0">
              <CheckBox x:Name="FinishRun" Content="Run DLSS 5 SUITE now" IsChecked="True" />
              <CheckBox x:Name="FinishWebsite" Content="Open potatoes-dev.com" />
            </StackPanel>
          </StackPanel>
        </Panel>

        <!-- ============================== FOOTER ============================== -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="40,20,40,28">
          <TextBlock Grid.Column="0" x:Name="StepText" Classes="Sub" VerticalAlignment="Center" />
          <Button Grid.Column="2" x:Name="BackButton" Classes="Ghost" Content="Back" Margin="0,0,10,0" />
          <Button Grid.Column="3" x:Name="NextButton" Classes="Primary" Content="Next" />
        </Grid>
      </Grid>
    </Panel>
  </Border>
</Window>
