<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DLSS_5_MANAGER.App"
             xmlns:local="using:DLSS_5_MANAGER"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- ==================================================================
             SCROLLBAR
             A full ControlTheme rather than a handful of style overrides.
             Fluent's own theme restyles the thumb through selectors like
             ScrollBar:pointerover /template/ Thumb, which are more specific
             than anything that can be written against it from here - every
             override lost the moment the pointer came near the bar, and the
             stock grey came back. Replacing the template is the only way to
             actually own the look.

             It is an overlay bar: no stepper buttons, a track that only
             appears on hover, and a thumb in the scheme accent that widens
             when the pointer is over it.
             ================================================================== -->
        <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="MinHeight" Value="12" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="TrackRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Margin="2">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>

                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Background="Transparent" BorderThickness="0"
                                              Focusable="False" MinWidth="0" MinHeight="0" />
                            </Track.DecreaseButton>

                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Background="Transparent" BorderThickness="0"
                                              Focusable="False" MinWidth="0" MinHeight="0" />
                            </Track.IncreaseButton>

                            <Track.Thumb>
                                <Thumb Name="ThumbEl"
                                       Background="{DynamicResource AppAccentSoftBrush}"
                                       BorderThickness="0"
                                       MinWidth="6" MinHeight="26" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>

            <!-- The thumb itself: rounded, accent coloured, and it grows into
                 the bar rather than the bar growing around it. A Thumb draws
                 nothing on its own, so it needs a template that paints the
                 Background it is given - without one the bar is invisible. -->
            <Style Selector="^ /template/ Thumb#ThumbEl">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                    </ControlTemplate>
                </Setter>
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
                        <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="^:horizontal /template/ Thumb#ThumbEl">
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="MinWidth" Value="26" />
                <Setter Property="MinHeight" Value="6" />
            </Style>

            <!-- Hovering the bar lights the track and fattens the thumb. -->
            <Style Selector="^:pointerover /template/ Border#TrackRoot">
                <Setter Property="Background" Value="{DynamicResource AppAccentFaintBrush}" />
            </Style>

            <Style Selector="^:pointerover /template/ Thumb#ThumbEl">
                <Setter Property="Background" Value="{DynamicResource AppAccentStrongBrush}" />
                <Setter Property="Margin" Value="1,0" />
            </Style>

            <Style Selector="^:horizontal:pointerover /template/ Thumb#ThumbEl">
                <Setter Property="Margin" Value="0,1" />
            </Style>

            <Style Selector="^ /template/ Thumb#ThumbEl:pressed">
                <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            </Style>

            <!-- Nothing to see when there is nothing to scroll. -->
            <Style Selector="^[IsEnabled=False]">
                <Setter Property="Opacity" Value="0" />
            </Style>
        </ControlTheme>

        <!-- Accent, themed.
             MainViewModel.publishAccent overwrites these whenever the colour
             scheme changes; the values here are the Neon Emerald defaults so
             anything using {DynamicResource ...} resolves before the first
             scheme is applied. -->
        <Color x:Key="AppAccentColor">#35D22B</Color>
        <SolidColorBrush x:Key="AppAccentBrush" Color="#35D22B" />
        <SolidColorBrush x:Key="AppAccentStrongBrush" Color="#DC35D22B" />
        <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#7835D22B" />
        <SolidColorBrush x:Key="AppAccentGlowBrush" Color="#3C35D22B" />
        <SolidColorBrush x:Key="AppAccentFaintBrush" Color="#1C35D22B" />

        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="Transparent" />
        <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#45FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#60FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFFFFF" />

        <!-- ToggleSwitch Glass Theme (Apple Frosted Light Silver / Grey) -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#94A3B8" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#CBD5E1" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#94A3B8" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#CBD5E1" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#71717A" />
        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#28FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#30FFFFFF" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Base Window & Container Theme Overrides -->
        <Style Selector="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe UI, Inter, SF Pro Display, System-UI, sans-serif" />
            <Setter Property="Foreground" Value="#F5F5F7" />
        </Style>

        <!-- Global ToolTip.
             The background used to be a white wash - 27% white at its
             strongest. Light text on that is unreadable the moment the tooltip
             opens over anything pale, which is most cover art. Dark glass
             instead, dense enough to be its own surface wherever it lands. -->
        <Style Selector="ToolTip">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#F21A1F26" Offset="0.0" />
                    <GradientStop Color="#F00E1116" Offset="0.55" />
                    <GradientStop Color="#F2141920" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3AFFFFFF" Offset="0.0" />
                    <GradientStop Color="#18FFFFFF" Offset="0.5" />
                    <GradientStop Color="#2CFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransformOrigin" Value="50%,0%" />
            <Style.Animations>
                <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-5" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="ToolTip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Glass Search Input Box Style (Integrated Dark Obsidian Glass) -->
        <Style Selector="TextBox.GlassSearchBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="#15000000" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="SelectionBrush" Value="#35FFFFFF" />
            <Setter Property="CaretBrush" Value="#CBD5E1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    <ThicknessTransition Property="Margin" Duration="0:0:0.26" Easing="CubicEaseOut" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox.GlassSearchBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox.GlassSearchBox /template/ Border#PART_BorderElement">
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="#15000000" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>

        <Style Selector="TextBox.GlassSearchBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#20000000" />
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
        </Style>

        <Style Selector="TextBox.GlassSearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#2C000000" />
            <Setter Property="BorderBrush" Value="#45FFFFFF" />
        </Style>

        <!-- Glass Window Control Buttons (Minimize, Maximize, Close) -->
        <Style Selector="Button.GlassWindowControlBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.GlassWindowControlBtn:pointerover">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>

        <Style Selector="Button.GlassWindowControlBtn.Close">
            <Setter Property="Background" Value="#30FF3B30" />
            <Setter Property="BorderBrush" Value="#50FF3B30" />
        </Style>

        <Style Selector="Button.GlassWindowControlBtn.Close:pointerover">
            <Setter Property="Background" Value="#50FF3B30" />
            <Setter Property="BorderBrush" Value="#80FF3B30" />
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>

        <!-- Segmented Tab Button [ GAMES ] [ APPS ] -->
        <Style Selector="Button.SegmentedTab">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="Padding" Value="22,7" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.SegmentedTab:pointerover">
            <Setter Property="Foreground" Value="#F5F5F7" />
        </Style>

        <Style Selector="Button.SegmentedTab.Active">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#45FFFFFF" Offset="0.0" />
                    <GradientStop Color="#20FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.SegmentedTab.Active:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FFFFFF" Offset="0.0" />
                    <GradientStop Color="#30FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Disabled (an install is running). The Fluent theme paints its own
             pale background on a disabled button, which made every tab look
             selected at once; these keep the selected one distinguishable. -->
        <Style Selector="Button.SegmentedTab:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.SegmentedTab:disabled">
            <Setter Property="Foreground" Value="#5A6068" />
        </Style>

        <Style Selector="Button.SegmentedTab.Active:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#2AFFFFFF" Offset="0.0" />
                    <GradientStop Color="#14FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.SegmentedTab.Active:disabled">
            <Setter Property="Foreground" Value="#C7CDD4" />
        </Style>

        <!-- Utility Action Buttons (Pure Translucent Glass - matches the app shell) -->
        <Style Selector="Button.EmptyActionBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#25FFFFFF" Offset="0.0" />
                    <GradientStop Color="#10FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.EmptyActionBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.EmptyActionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#38FFFFFF" Offset="0.0" />
                    <GradientStop Color="#1DFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.EmptyActionBtn:pointerover">
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="Button.EmptyActionBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <!-- Disabled state for every glass button family -->
        <Style Selector="Button.EmptyActionBtn:disabled, Button.ApplePrimaryBtn:disabled, Button.AppleSecondaryBtn:disabled, Button.AppleDangerBtn:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Sub-Header Filter Pill Button (Pure Translucent Glass) -->
        <Style Selector="Button.FilterPill">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="#D1D1D6" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.FilterPill:pointerover">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#45FFFFFF" />
        </Style>

        <Style Selector="Button.FilterPill.Active">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#45FFFFFF" Offset="0.0" />
                    <GradientStop Color="#25FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#60FFFFFF" />
        </Style>

        <!-- Bottom Control Dock Panel (Border-less Pure Glass Dock) -->
        <Style Selector="Border.ControlDock">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#40FFFFFF" Offset="0.0" />
                    <GradientStop Color="#16FFFFFF" Offset="0.4" />
                    <GradientStop Color="#10FFFFFF" Offset="0.7" />
                    <GradientStop Color="#2EFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BoxShadow" Value="0 18 50 0 #80000000" />
        </Style>

        <!-- Clean Card Button (Seamless Transparent Host for Rounded Glass Cards) -->
        <Style Selector="Button.CleanCardBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.CleanCardBtn:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransform" Value="scale(1.008)" />
        </Style>

        <Style Selector="Button.CleanCardBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button.CleanCardBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style Selector="Button.CleanCardBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- Primary Action Button (Apple macOS Frosted Glass) -->
        <Style Selector="Button.ApplePrimaryBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#45FFFFFF" Offset="0.0" />
                    <GradientStop Color="#1CFFFFFF" Offset="0.5" />
                    <GradientStop Color="#30FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#65FFFFFF" Offset="0.0" />
                    <GradientStop Color="#15FFFFFF" Offset="0.5" />
                    <GradientStop Color="#40FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ApplePrimaryBtn:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FFFFFF" Offset="0.0" />
                    <GradientStop Color="#28FFFFFF" Offset="0.5" />
                    <GradientStop Color="#45FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>

        <Style Selector="Button.ApplePrimaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FFFFFF" Offset="0.0" />
                    <GradientStop Color="#28FFFFFF" Offset="0.5" />
                    <GradientStop Color="#45FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Secondary Subdued Button (Pure macOS Translucent Glass) -->
        <Style Selector="Button.AppleSecondaryBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#25FFFFFF" Offset="0.0" />
                    <GradientStop Color="#10FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.AppleSecondaryBtn:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#38FFFFFF" Offset="0.0" />
                    <GradientStop Color="#1DFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="Button.AppleSecondaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#38FFFFFF" Offset="0.0" />
                    <GradientStop Color="#1DFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Danger / Stop Button (Pure macOS Translucent Crimson Frost Glass) -->
        <Style Selector="Button.AppleDangerBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#40FF453A" Offset="0.0" />
                    <GradientStop Color="#18FF453A" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FF6B6B" />
            <Setter Property="BorderBrush" Value="#60FF453A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.AppleDangerBtn:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FF453A" Offset="0.0" />
                    <GradientStop Color="#25FF453A" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#80FF453A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="Button.AppleDangerBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FF453A" Offset="0.0" />
                    <GradientStop Color="#25FF453A" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#80FF453A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Minimal Input Styling -->
        <Style Selector="TextBox.AppleInput">
            <Setter Property="Background" Value="#14151C" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#252733" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBox.AppleInput:focus">
            <Setter Property="BorderBrush" Value="#00F0FF" />
        </Style>

        <!-- Modern Glass Card Overlay Frame -->
        <Style Selector="Border.GlassModalCard">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#F0121A15" Offset="0.0" />
                    <GradientStop Color="#F8080D0A" Offset="0.6" />
                    <GradientStop Color="#FD0C1410" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#55FFFFFF" Offset="0.0" />
                    <GradientStop Color="#18FFFFFF" Offset="0.5" />
                    <GradientStop Color="#4500FF88" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BoxShadow" Value="0 24 60 0 #A0000000" />
        </Style>

        <!-- Glass ComboBox & Dropdown Popup Theme (macOS Glassmorphism Popover) -->
        <Style Selector="ComboBox.GlassComboBox">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ComboBox.GlassComboBox /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="ComboBox.GlassComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
        </Style>

        <!-- Glass Popover Container (Dropdown List Box - Neutral Frosted Smoky Glass) -->
        <Style Selector="ComboBox.GlassComboBox /template/ Border#PopupBorder">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#E8161622" Offset="0.0" />
                    <GradientStop Color="#D50C0C14" Offset="0.5" />
                    <GradientStop Color="#DF10101A" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#65FFFFFF" Offset="0.0" />
                    <GradientStop Color="#18FFFFFF" Offset="0.5" />
                    <GradientStop Color="#40FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BoxShadow" Value="0 22 55 0 #B0000000, 0 0 1 1 #25FFFFFF" />
        </Style>

        <Style Selector="ComboBox.GlassComboBox /template/ ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Dropdown open animation.
             The popup used to appear fully formed. It now drops in: a short
             fade with a slight downward slide and a scale that settles, so the
             list reads as coming out of the box it belongs to. Animation rather
             than Transitions, because the popup is created on open and there is
             no "before" value for a transition to run from. -->
        <Style Selector="ComboBox.GlassComboBox /template/ Border#PopupBorder">
            <Setter Property="RenderTransformOrigin" Value="50%,0%" />
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-8" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The chevron turns over as the list opens. -->
        <Style Selector="ComboBox.GlassComboBox /template/ Path#DropDownGlyph">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ComboBox.GlassComboBox:dropdownopen /template/ Path#DropDownGlyph">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>

        <!-- Glass ComboBoxItem (Dropdown Items) -->
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="ComboBoxItem">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="RenderTransform" Value="translateX(3px)" />
        </Style>

        <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F5F5F7" />
        </Style>

        <!-- Item Hover State (Subtle Neutral Frosted Glass Glow) -->
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Item Selected State (Luminous Pure Frosted Glass Highlight) -->
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#50FFFFFF" Offset="0.0" />
                    <GradientStop Color="#2CFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Item Selected + Hover State -->
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#65FFFFFF" Offset="0.0" />
                    <GradientStop Color="#38FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Custom Glass FlyoutPresenter (Border-less Pure Dark Glass Popup) -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- Glass Quick Action Dropdown Item Button -->
        <Style Selector="Button.GlassMenuActionBtn">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.GlassMenuActionBtn:pointerover">
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
        </Style>

        <Style Selector="Button.GlassMenuActionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
        </Style>

        <Style Selector="Button.GlassMenuActionBtn:pressed">
            <Setter Property="Background" Value="#40FFFFFF" />
        </Style>

        <Style Selector="Button.GlassMenuActionBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF" />
        </Style>

        <!-- Glass ContextMenu & MenuItem Theme (Strong Frosted Blur Glass) -->
        <Style Selector="ContextMenu.GlassContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border CornerRadius="18" 
                            ClipToBounds="True" 
                            BorderThickness="1.5"
                            BoxShadow="0 18 45 0 #90000000">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#C0FFFFFF" Offset="0.0" />
                                <GradientStop Color="#45FFFFFF" Offset="0.5" />
                                <GradientStop Color="#85FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Panel>
                            <!-- Dense Diffuse Misty Base (Diffuses and completely softens background clutter) -->
                            <Border CornerRadius="18" Background="#D51C182A" />
                            
                            <!-- Pure Steamed White Vapor Gradient Overlay -->
                            <Border CornerRadius="18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#65FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#22FFFFFF" Offset="0.4" />
                                        <GradientStop Color="#18FFFFFF" Offset="0.7" />
                                        <GradientStop Color="#50FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Content Items List -->
                            <Border Padding="6">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                KeyboardNavigation.TabNavigation="Continue" />
                            </Border>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ContextMenu.GlassContextMenu MenuItem">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="ContextMenu.GlassContextMenu MenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#45FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!-- GAME CARD HOVER
             The card used to grow by animating Width and Height. Those are
             layout properties: every hover re-measured and re-arranged the
             grid, and with no transitions on them it snapped from one size to
             the other. Scaling a RenderTransform instead is a composited
             property - it never touches layout, so the rest of the grid stays
             put and the motion can actually be eased.

             The lift is scale plus a few pixels upward, with the border and
             shadow coming up together, which is what reads as the card
             rising off the page rather than just getting bigger. -->
        <Style Selector="Border.InnerGameCard">
            <Setter Property="Width" Value="198" />
            <Setter Property="Height" Value="268" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #40000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.26" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.26" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="StackPanel.GameCardItem:pointerover Border.InnerGameCard">
            <Setter Property="RenderTransform" Value="scale(1.05) translateY(-5px)" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="BoxShadow" Value="0 14 34 0 #85000000, 0 0 0 1 #30FFFFFF" />
        </Style>

        <!-- Pressing takes it back below rest size, so a click has a physical
             answer rather than only opening the sheet. Faster than the lift:
             presses should feel immediate, releases can breathe. -->
        <Style Selector="StackPanel.GameCardItem:pointerdown Border.InnerGameCard">
            <Setter Property="RenderTransform" Value="scale(0.975) translateY(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.09" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>

        <!-- The title under the card comes up with it. -->
        <Style Selector="StackPanel.GameCardItem TextBlock">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- ================================================================= -->
        <!-- GENERAL MOTION                                                    -->
        <!-- Buttons had no transitions at all, so every hover and press was a
             hard cut. These are deliberately short - long easing on a control
             you click reads as lag, not polish.                               -->
        <!-- ================================================================= -->
        <Style Selector="Button">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.025)" />
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- ================================================================= -->
        <!-- GLASS                                                             -->
        <!-- A specular top edge and a soft inner rim. Glass reads as glass
             because light catches its top edge; a flat translucent panel just
             reads as a grey box. Applied to the card classes the app already
             uses, so the look changes without the palette changing.           -->
        <!-- ================================================================= -->
        <Style Selector="Border.GlassModalCard">
            <Setter Property="BoxShadow" Value="0 26 70 0 #B8000000, 0 1 0 0 #2AFFFFFF" />
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Glass reads as glass because light catches its top edge and the
             body is dense enough to sit things on. A flat 3% white wash over a
             bright backdrop is neither - it just tints whatever is behind it,
             which is why the settings text was hard to read over the mark. -->
        <Style Selector="Border.SettingsCard">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="BoxShadow" Value="0 4 18 0 #4A000000, 0 1 0 0 #1EFFFFFF" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.SettingsCard:pointerover">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#2CFFFFFF" />
            <Setter Property="BoxShadow" Value="0 8 26 0 #55000000, 0 1 0 0 #26FFFFFF" />
        </Style>

        <!-- ================================================================= -->
        <!-- FLOATING BACKGROUND ATMOSPHERIC ANIMATIONS                        -->
        <!-- ================================================================= -->
        <!-- A shooting star: a thin streak with a bright head and a tail that
             fades out behind it. Positioned, rotated and faded entirely from
             the code-behind, which owns when they appear and where. -->
        <Style Selector="Border.Shooter">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                        <GradientStop Color="#33DFFFE8" Offset="0.55" />
                        <GradientStop Color="#CCFFFFFF" Offset="0.93" />
                        <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The starfield twinkle is driven from MainWindow.axaml.fs, not from
             a style here. The keyframed version produced no visible change on
             screen and gave nothing to diagnose; a timer in code-behind is
             plain to read and plain to check. -->

        <Style Selector="Panel.Motion Border.FloatOrb1">
            <Style.Animations>
                <Animation Duration="0:0:16.0" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="TranslateTransform.X" Value="45" />
                        <Setter Property="TranslateTransform.Y" Value="-35" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.X" Value="20" />
                        <Setter Property="TranslateTransform.Y" Value="40" />
                    </KeyFrame>
                    <KeyFrame Cue="75%">
                        <Setter Property="TranslateTransform.X" Value="-35" />
                        <Setter Property="TranslateTransform.Y" Value="-20" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Panel.Motion Border.FloatOrb2">
            <Style.Animations>
                <Animation Duration="0:0:22.0" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="30%">
                        <Setter Property="TranslateTransform.X" Value="-55" />
                        <Setter Property="TranslateTransform.Y" Value="40" />
                    </KeyFrame>
                    <KeyFrame Cue="65%">
                        <Setter Property="TranslateTransform.X" Value="30" />
                        <Setter Property="TranslateTransform.Y" Value="-30" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Panel.Motion Border.FloatOrb3">
            <Style.Animations>
                <Animation Duration="0:0:14.0" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="TranslateTransform.X" Value="30" />
                        <Setter Property="TranslateTransform.Y" Value="35" />
                    </KeyFrame>
                    <KeyFrame Cue="80%">
                        <Setter Property="TranslateTransform.X" Value="-25" />
                        <Setter Property="TranslateTransform.Y" Value="-25" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Panel.Motion Border.FloatAurora1">
            <Style.Animations>
                <Animation Duration="0:0:18.0" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="-60" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.22" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.X" Value="60" />
                        <Setter Property="TranslateTransform.Y" Value="-40" />
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="-60" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.22" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Panel.Motion Border.FloatAurora2">
            <Style.Animations>
                <Animation Duration="0:0:24.0" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="80" />
                        <Setter Property="TranslateTransform.Y" Value="20" />
                        <Setter Property="Opacity" Value="0.18" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.X" Value="-70" />
                        <Setter Property="TranslateTransform.Y" Value="-30" />
                        <Setter Property="Opacity" Value="0.38" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="80" />
                        <Setter Property="TranslateTransform.Y" Value="20" />
                        <Setter Property="Opacity" Value="0.18" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Panel.Motion Border.FloatCrystal1">
            <Style.Animations>
                <Animation Duration="0:0:22.0" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.X" Value="35" />
                        <Setter Property="TranslateTransform.Y" Value="-35" />
                        <Setter Property="RotateTransform.Angle" Value="180" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Panel.Motion Border.FloatCrystal2">
            <Style.Animations>
                <Animation Duration="0:0:18.0" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.X" Value="-30" />
                        <Setter Property="TranslateTransform.Y" Value="25" />
                        <Setter Property="RotateTransform.Angle" Value="180" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Panel.Motion Border.FloatParticle1">
            <Style.Animations>
                <Animation Duration="0:0:10.0" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.Y" Value="-45" />
                        <Setter Property="TranslateTransform.X" Value="20" />
                        <Setter Property="Opacity" Value="0.65" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Panel.Motion Border.FloatParticle2">
            <Style.Animations>
                <Animation Duration="0:0:13.0" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.Y" Value="-60" />
                        <Setter Property="TranslateTransform.X" Value="-25" />
                        <Setter Property="Opacity" Value="0.75" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Panel.Motion Border.FloatFlux1">
            <Style.Animations>
                <Animation Duration="0:0:12.0" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="-120" />
                        <Setter Property="Opacity" Value="0.08" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.X" Value="120" />
                        <Setter Property="Opacity" Value="0.4" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="-120" />
                        <Setter Property="Opacity" Value="0.08" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>


        <!-- ==============================================================
             TOGGLE SWITCH MOTION
             The stock switch snaps: the knob jumps and the track colour cuts
             over. These transitions are on the template parts, so they apply to
             every ToggleSwitch without re-declaring the template. The knob
             overshoots very slightly on the way across, which is what makes a
             switch feel mechanical rather than instant.
             ============================================================== -->
        <Style Selector="ToggleSwitch /template/ Grid#SwitchAreaGrid">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.24" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOn, ToggleSwitch /template/ Ellipse#SwitchKnobOff">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleSwitch /template/ Canvas#MovingKnobs">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleSwitch:pointerover /template/ Grid#SwitchAreaGrid">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>

        <Style Selector="ToggleSwitch /template/ Grid#SwitchAreaGrid">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        </Style>

        <!-- ==================================================================
             MOTION LIBRARY
             Reusable classes for the things that appear, load or answer a
             click. Kept as classes rather than one-off animations so the same
             timing is shared everywhere and there is one place to retune it.

             Everything here animates Opacity and RenderTransform only. Those
             are composited properties - they never trigger layout, so adding
             motion costs the compositor a matrix and nothing else. Animating
             Width, Height or Margin instead is what makes an interface stutter
             once there is a lot on screen.
             ================================================================== -->

        <!-- Indeterminate progress: a bar that slides through its track rather
             than a segment that jumps. -->
        <Style Selector="ProgressBar.Flow /template/ Border#PART_Indicator">
            <Setter Property="RenderTransformOrigin" Value="0%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.25" />
                        <Setter Property="TranslateTransform.X" Value="-40" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.25" />
                        <Setter Property="TranslateTransform.X" Value="40" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- A slow breath for anything that is waiting on work. -->
        <Style Selector=":is(Control).Pulse">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:1.8" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.55" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.02" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.02" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.55" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The shimmer that runs across a placeholder while its real content
             is still being fetched. -->
        <Style Selector=":is(Control).Shimmer">
            <Setter Property="RenderTransformOrigin" Value="0%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.1" />
                        <Setter Property="TranslateTransform.X" Value="-220" />
                    </KeyFrame>
                    <KeyFrame Cue="45%">
                        <Setter Property="Opacity" Value="0.4" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.1" />
                        <Setter Property="TranslateTransform.X" Value="220" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Entrances. Rise is the general one; Pop overshoots slightly and is
             for things that should feel like they landed. -->
        <Style Selector=":is(Control).Rise">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:0.42" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="18" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector=":is(Control).Pop">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:0.36" Easing="BackEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Modal sheets land with a small overshoot, which is what makes them
             read as arriving rather than being switched on. -->
        <Style Selector="Border.GlassModalCard">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:0.3" Easing="BackEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Rows in a list arrive one after another rather than all at once.
             Four beats is enough to read as a cascade; more and the last row
             keeps the user waiting. -->
        <Style Selector=":is(Control).RowIn">
            <Style.Animations>
                <Animation Duration="0:0:0.34" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="-14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector=":is(Control).RowIn.Beat2">
            <Style.Animations>
                <Animation Duration="0:0:0.34" Delay="0:0:0.06" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The toggle knob squashes as it crosses and settles back, which is
             what a physical switch does. -->
        <Style Selector="ToggleSwitch:checked /template/ Canvas#MovingKnobs">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:0.34" Easing="BackEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.72" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.14" />
                    </KeyFrame>
                    <KeyFrame Cue="55%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.12" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Dropdown items cascade in behind the popup itself. -->
        <Style Selector="ComboBox.GlassComboBox ComboBoxItem">
            <Style.Animations>
                <Animation Duration="0:0:0.26" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ============================================================== -->
        <!-- PAGE REVEAL                                                     -->
        <!-- Switching pages used to snap every card and icon into place at   -->
        <!-- once. Each card now rises and fades in on a slightly later beat, -->
        <!-- which reads as one motion instead of a flash.                    -->
        <!-- ============================================================== -->
        <Style Selector="Border.SettingsCard">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Holds the settled state only. The motion belongs to the Stagger
             styles below - putting an animation here too would match the same
             card twice and play the reveal on top of itself. -->
        <Style Selector="Border.SettingsCard.Shown">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Staggered entry: 60 ms between neighbours keeps it brisk. -->
        <Style Selector="Border.SettingsCard.Shown.Stagger1">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.00" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SettingsCard.Shown.Stagger2">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.06" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SettingsCard.Shown.Stagger3">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.12" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SettingsCard.Shown.Stagger4">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.18" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SettingsCard.Shown.Stagger5">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.24" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.SettingsCard.Shown.Stagger6">
            <Style.Animations>
                <Animation Duration="0:0:0.42" Delay="0:0:0.30" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The games grid comes back as one soft pane rather than a snap. -->
        <Style Selector="Border.PageReveal">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Border.PageReveal.Shown">
            <Setter Property="Opacity" Value="1" />
            <Style.Animations>
                <Animation Duration="0:0:0.38" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="12" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ============================================================== -->
        <!-- Route reveal                                                    -->
        <!-- Switching install route shows and hides whole rows - the API    -->
        <!-- picker, the build picker, the two add-on switches. Appearing    -->
        <!-- instantly reads as a jump, so they slide in the way the app's   -->
        <!-- own pages do, only shorter: this is a row inside a sheet, not a -->
        <!-- page. Bind Classes.Shown and IsVisible to the same property.    -->
        <!-- ============================================================== -->
        <Style Selector=":is(Control).RouteReveal.Shown">
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ============================================================== -->
        <!-- Glass link buttons (Ko-fi / YouTube)                            -->
        <!-- ============================================================== -->
        <Style Selector="Button.GlassLinkBtn">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#22FFFFFF" Offset="0.0" />
                    <GradientStop Color="#0EFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#2BFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.GlassLinkBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>

        <!-- Each link picks up a hint of its own brand on hover, no more -->
        <Style Selector="Button.GlassLinkBtn.Donate:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3CFF5E8A" Offset="0.0" />
                    <GradientStop Color="#16FF5E8A" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#66FF5E8A" />
        </Style>

        <Style Selector="Button.GlassLinkBtn.Tutorials:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3CFF4444" Offset="0.0" />
                    <GradientStop Color="#16FF4444" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#66FF4444" />
        </Style>

        <!-- Header pill announcing a newer build -->
        <Style Selector="Button.UpdatePill">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3800FF88" Offset="0.0" />
                    <GradientStop Color="#1400FF88" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#5500FF88" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.UpdatePill:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>

        <Style Selector="Button.UpdatePill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#5500FF88" Offset="0.0" />
                    <GradientStop Color="#2400FF88" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#8000FF88" />
        </Style>

        <!-- A settings section title that folds its own contents away. It has
             to look like the plain heading it replaces, so the button chrome
             is stripped entirely and only the hover tint remains. -->
        <Style Selector="Button.SectionHeader">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- The whole title row is the hit target, but it must still read as a
             heading: no button chrome at all, and nothing that fills the card. -->
        <Style Selector="Button.SectionHeader /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.SectionHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- The affordance lives in one small round control on the right, the
             same shape as the fold button in the Manage sheet. -->
        <Style Selector="Border.SectionChevron">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#1CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.SectionHeader:pointerover Border.SectionChevron">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
        </Style>

        <Style Selector="Button.SectionHeader:pointerover TextBlock.SectionTitle">
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="LetterSpacing" Value="0.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Holds one family of chips - a route and its variants - so the
             groups read apart instead of running together in one long row. -->
        <Style Selector="Border.ChipGroup">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="#0C1014" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A route that already installs a file of the same name is ruled
             out, and has to look ruled out. -->
        <Style Selector="Border.ChipGroup:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- The mark a card wears once the mod is on it: a small frosted bead
             in the top-right corner. Says "done" without covering the artwork;
             which route it was is on the tooltip. -->
        <!-- A frosted halo with the bead floating in it, so it reads as part
             of the glass rather than a sticker dropped on the artwork. -->
        <!-- ================================================================= -->
        <!-- CARD CORNER TAGS                                                  -->
        <!-- ================================================================= -->
        <!-- Top left: the mod is installed. A green rounded outline around
             green text, so it reads as a state the card is in rather than a
             button to press. -->
        <!-- Now holds a single tick, so it is round rather than a pill and
             sized to the glyph. The border follows the colour scheme like the
             API chip opposite it. -->
        <Style Selector="Border.InstalledTag">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="9,9,0,0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="Background" Value="#8A050D07" />
            <Setter Property="BoxShadow" Value="{DynamicResource AppAccentChipShadow}" />
        </Style>

        <!-- Centre the tick inside that circle. -->
        <Style Selector="Border.InstalledTag > Panel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.InstalledTag TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.TagGreen">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- The four offset copies that stand in for a text stroke. -->
        <Style Selector="TextBlock.TagOutline">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Top right: what the game renders with.
             A glass chip rather than bare text. Plain white with a glow
             vanished against a pale cover - Assassin's Creed Brotherhood and
             Revelations both ship near-white artwork and the label was
             unreadable on both. The dark plate gives it a constant background
             whatever it sits on, and the green rim and lit pip make it read as
             something the app measured rather than a caption. -->
        <Style Selector="Border.ApiChip">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,9,9,0" />
            <Setter Property="Padding" Value="7,3,8,3" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource AppAccentChipShadow}" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#E6112A16" Offset="0.0" />
                        <GradientStop Color="#F2060D08" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.ApiPip">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="2.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource AppAccentPipShadow}" />
        </Style>

        <Style Selector="TextBlock.ApiTag">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Effect" Value="{DynamicResource AppAccentTextGlow}" />
        </Style>

        <Style Selector="Border.ModDot > Border">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background">
                <RadialGradientBrush Center="35%,28%" GradientOrigin="35%,28%" RadiusX="75%" RadiusY="75%">
                    <GradientStop Color="#FFDFFFEE" Offset="0.0" />
                    <GradientStop Color="#FF3BFFA6" Offset="0.45" />
                    <GradientStop Color="#FF00C46E" Offset="1.0" />
                </RadialGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 0 9 0 #A000FF88" />
        </Style>

        <!-- Read-only chips stating what the game turned out to be. Deliberately
             colourless - they are facts, not controls, and must not compete
             with the accent that marks the live route. -->
        <Style Selector="Border.DetectChip">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.DetectChipText">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#A8B3C2" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>

        <!-- Frosted marker pinned to the install route that is actually live -->
        <Style Selector="Border.ActiveRouteDot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0,4,6,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="Background">
                <RadialGradientBrush Center="35%,30%" GradientOrigin="35%,30%" RadiusX="70%" RadiusY="70%">
                    <GradientStop Color="#FF9BFFC8" Offset="0.0" />
                    <GradientStop Color="#E600FF88" Offset="0.55" />
                    <GradientStop Color="#B300C264" Offset="1.0" />
                </RadialGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 0 8 0 #8000FF88" />
        </Style>

        <!-- ============================================================== -->
        <!-- Glass Context Menu / Flyout (matches the Apple frosted popover) -->
        <!-- ============================================================== -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#E8121A15" Offset="0.0" />
                    <GradientStop Color="#D5080D0A" Offset="0.5" />
                    <GradientStop Color="#DF0C1410" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#60FFFFFF" Offset="0.0" />
                    <GradientStop Color="#18FFFFFF" Offset="0.5" />
                    <GradientStop Color="#4500FF88" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="MenuFlyoutPresenter /template/ ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="MenuFlyoutPresenter > MenuItem">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="MenuFlyoutPresenter > MenuItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="MenuFlyoutPresenter > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#2600FF88" />
        </Style>

        <Style Selector="MenuFlyoutPresenter > MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Plain (non-menu) flyouts get the same frosted shell -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#E8121A15" Offset="0.0" />
                    <GradientStop Color="#DF0C1410" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

    </Application.Styles>
</Application>
