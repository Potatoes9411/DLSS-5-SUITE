<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DLSS_5_MANAGER.ViewModels"
        x:Class="DLSS_5_MANAGER.Views.ScreenEngineWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo.ico"
        Title="Screen Engine - DLSS 5 SUITE"
        Width="640" Height="780" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowDecorations="None">

    <Border CornerRadius="24" ClipToBounds="True" Background="Transparent">
        <Panel>
            <!-- The app's own backdrop, bound to the same theme so it matches. -->
            <Panel ClipToBounds="True" IsHitTestVisible="False">
                <Border Background="{Binding BgBaseBrush}" />
                <Image Source="{Binding NebulaSource}" Stretch="UniformToFill" Opacity="0.82" />
                <Image Source="/Assets/bg_stars_1.png" Stretch="UniformToFill" Opacity="0.6" />
                <Image Source="{Binding NvidiaMarkSource}" Stretch="Uniform" Width="460"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.22" />
                <Border Background="{Binding BgVignetteBrush}" />
                <Border Background="#18000000" />
            </Panel>
            <Border CornerRadius="24" BorderThickness="1" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2CFFFFFF" Offset="0.0" />
                        <GradientStop Color="#08FFFFFF" Offset="0.5" />
                        <GradientStop Color="#1CFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>

            <Grid RowDefinitions="Auto,*">
                <!-- Title bar: drag to move -->
                <Border Grid.Row="0" Background="Transparent" Padding="20,14,14,6" PointerPressed="OnHeaderPointerPressed">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" Source="/Assets/logo_bar.png" Height="26" Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="SCREEN ENGINE" FontSize="12" FontWeight="Bold" Foreground="White" LetterSpacing="0.6" />
                            <TextBlock Text="DLSS 5 on any screen" FontSize="11" Foreground="#94A3B8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="GlassWindowControlBtn" Click="OnMinimizeClicked" ToolTip.Tip="Minimize">
                            <PathIcon Data="M 19,13 H 5 V 11 H 19 V 13 Z" Width="10" Height="10" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </Button>
                        <Button Classes="GlassWindowControlBtn Close" Click="OnCloseClicked" ToolTip.Tip="Close">
                            <PathIcon Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z" Width="10" Height="10" Foreground="#FF6961" VerticalAlignment="Center" />
                        </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="16,4,16,16">
                    <Border Background="#66101418" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20">
                        <StackPanel Spacing="12" DataContext="{Binding ScreenEngine}">
                            <Border x:Name="OverlayBar" IsVisible="False" Background="#2200FF88" BorderBrush="#5500FF88" BorderThickness="1" CornerRadius="12" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="DLSS 5 SUITE controls · Num2 hides them" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Content="Reopen DLSS 5 SUITE window" Click="OnReopenSuiteClicked" />
                                </Grid>
                            </Border>
                            <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Panel Grid.Column="0" ToolTip.Tip="{Binding ScreenEngineTip}" ToolTip.ShowOnDisabled="True" Background="Transparent">
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsScreenEngine}" Click="OnMethodScreenEngineClicked" IsEnabled="{Binding !ScreenEngineLocked}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="Screen Engine" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="RTX 50 series" FontSize="10.5" Opacity="0.75" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Locked: a red line across the button -->
                                    <Line IsVisible="{Binding ScreenEngineLocked}" StartPoint="8,44" EndPoint="236,6" Stretch="Fill" Margin="10,6"
                                          Stroke="#EF4444" StrokeThickness="2.5" IsHitTestVisible="False" />
                                </Panel>
                                <Panel Grid.Column="2" ToolTip.Tip="{Binding RobloxShadeHostTip}" ToolTip.ShowOnDisabled="True" Background="Transparent">
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsRobloxShadeHost}" Click="OnMethodRobloxShadeHostClicked" IsEnabled="{Binding !RobloxShadeHostLocked}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="RobloxShadeHost" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="Roblox / ReShade" FontSize="10.5" Opacity="0.75" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Line IsVisible="{Binding RobloxShadeHostLocked}" StartPoint="8,44" EndPoint="236,6" Stretch="Fill" Margin="10,6"
                                          Stroke="#EF4444" StrokeThickness="2.5" IsHitTestVisible="False" />
                                </Panel>
                                <Panel Grid.Column="1" ToolTip.Tip="{Binding NeuralScreenTip}" ToolTip.ShowOnDisabled="True" Background="Transparent">
                                    <Button Classes="SegmentedTab" Classes.Active="{Binding IsNeuralScreen}" Click="OnMethodNeuralScreenClicked" IsEnabled="{Binding !NeuralScreenLocked}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="NeuralScreen" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="RTX 30 / 40 series" FontSize="10.5" Opacity="0.75" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Locked: a red line across the button -->
                                    <Line IsVisible="{Binding NeuralScreenLocked}" StartPoint="8,44" EndPoint="236,6" Stretch="Fill" Margin="10,6"
                                          Stroke="#EF4444" StrokeThickness="2.5" IsHitTestVisible="False" />
                                </Panel>
                            </Grid>
                            <TextBlock Text="{Binding MethodNote}" FontSize="11" Foreground="#A3AEC0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding GpuName}" FontSize="10.5" Foreground="#64748B" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="{Binding ActivePresetText}" FontSize="11.5" Foreground="#CBD5E1" VerticalAlignment="Center"
                                           ToolTip.Tip="Save settings for a game from its Manage sheet; they switch in when you start it from its card." />
                                <Button Grid.Column="1" Content="Use default settings" Click="OnUseDefaultSettingsClicked" IsVisible="{Binding IsGamePreset}" />
                            </Grid>
                            <Border IsVisible="{Binding NeuralScreenNeedsInstall}" Background="#22FBBF24" BorderBrush="#55FBBF24" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="NeuralScreen is a separate download (about 221 MB), because only RTX 30/40 cards need it. SUITE fetches and installs it here." Foreground="#FDE68A" FontSize="11.5" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="PrimaryActionBtn" Content="Download and install" Click="OnGetNeuralScreenClicked" IsEnabled="{Binding !IsInstallingAddon}" />
                                        <Button Content="Install from zip..." Click="OnInstallNeuralScreenClicked" IsEnabled="{Binding !IsInstallingAddon}" />
                                    </StackPanel>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding AddonProgress}" Height="6" IsVisible="{Binding IsInstallingAddon}" />
                                    <TextBlock Text="{Binding AddonStatus}" Foreground="#FDE68A" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Full-screen DLSS 5 Neural Rendering" FontSize="13.5" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="PrimaryActionBtn" Content="Start" Click="OnScreenEngineStartClicked" IsVisible="{Binding CanStart}" />
                                    <Button Content="Stop" Click="OnScreenEngineStopClicked" IsVisible="{Binding IsRunning}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Capture" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <ComboBox Classes="GlassComboBox" ItemsSource="{Binding SourceOptions}"
                                              SelectedIndex="{Binding SelectedSourceIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Height="34" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding IsScreenEngine}">
                                    <TextBlock Text="Show on" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <ComboBox Classes="GlassComboBox" ItemsSource="{Binding TargetOptions}"
                                              SelectedIndex="{Binding SelectedTargetIndex, Mode=TwoWay}"
                                              IsEnabled="{Binding CanPickTarget}"
                                              HorizontalAlignment="Stretch" Height="34" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Capture one window" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                <TextBlock Text="Live Flow: DLSS 5 over any app or game window - switch it to borderless windowed mode first, then pick it here."
                                           FontSize="10.5" Foreground="#7DD3FC" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Cursor="Cross"
                                            Background="#5C121619" BorderBrush="#5500FF88" BorderThickness="1"
                                            ToolTip.Tip="Click, then Alt+Tab and click a window — or drag this crosshair onto it"
                                            PointerPressed="OnCrosshairPressed" PointerMoved="OnCrosshairMoved"
                                            PointerReleased="OnCrosshairReleased" PointerCaptureLost="OnCrosshairCaptureLost">
                                        <PathIcon Width="24" Height="24" Foreground="#4ADE80"
                                                  Data="F1 M11,1 H13 V6 H11 Z M11,18 H13 V23 H11 Z M1,11 H6 V13 H1 Z M18,11 H23 V13 H18 Z M12,6.5 A5.5,5.5 0 1 0 12,17.5 A5.5,5.5 0 1 0 12,6.5 Z M12,8.5 A3.5,3.5 0 1 1 12,15.5 A3.5,3.5 0 1 1 12,8.5 Z" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PickerText}" FontSize="12.5" Foreground="White" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Window, StringFormat='Handle / title: {0}', TargetNullValue=''}" FontSize="11" Foreground="#A3AEC0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Use monitor" Click="OnClearWindowClicked" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" Classes="GlassComboBox" ItemsSource="{Binding WindowOptions}"
                                              SelectedIndex="{Binding SelectedWindowIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="34" />
                                    <Button Grid.Column="1" Content="Refresh" Click="OnScreenEngineRefreshWindowsClicked" />
                                </Grid>
                                <TextBox Text="{Binding Window, Mode=TwoWay}" PlaceholderText="Or type a window title" Height="34" IsVisible="{Binding IsScreenEngine}" />
                            </StackPanel>

                            <Border Height="1" Background="#24FFFFFF" Margin="0,3" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="11">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Neural Rendering" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Off leaves only super resolution, when a second monitor is the output." FontSize="11" Foreground="#A3AEC0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding NeuralRendering, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="10" IsVisible="{Binding NeuralRendering}">
                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="Intensity" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Intensity, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding IntensityText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Type any value, then press Tab or click away" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="Local structure" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding LocalStructureSlider, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding LocalStructureText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Type any value, then press Tab or click away" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Keep original colours" FontSize="12" Foreground="#CBD5E1" />
                                        <TextBlock Text="Sharpen and clean the picture without touching its colour or tone. Local tone and style do nothing while this is on." FontSize="11" Foreground="#A3AEC0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepOriginalColours, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10" IsEnabled="{Binding ColoursUnlocked}">
                                    <TextBlock Grid.Column="0" Text="Local tone" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding LocalToneSlider, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding LocalToneText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Type any value, then press Tab or click away" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="Passes" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding PassesSlider, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding PassesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Type any value, then press Tab or click away" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Style" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" Width="110" />
                                        <ComboBox Classes="GlassComboBox" ItemsSource="{Binding StyleOptions}"
                                                  SelectedIndex="{Binding SelectedStyleIndex, Mode=TwoWay}" MinWidth="150" Height="34" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsScreenEngine}">
                                        <TextBlock Text="Auto mask" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <ToggleSwitch IsChecked="{Binding AutoMask, Mode=TwoWay}" OnContent="" OffContent="" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="#24FFFFFF" Margin="0,3" IsVisible="{Binding IsNeuralScreen}" />

                            <!-- Everything NeuralScreen has that the Screen Engine does not.
                                 Its own menu never opens, so these live here. -->
                            <StackPanel Spacing="10" IsVisible="{Binding IsNeuralScreen}">
                                <TextBlock Text="NEURALSCREEN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Boost" FontSize="12" Foreground="#CBD5E1" />
                                        <TextBlock Text="Run the model at a reduced resolution and composite it back. Off processes every pixel." FontSize="11" Foreground="#A3AEC0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Boost, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10" IsEnabled="{Binding Boost}">
                                    <TextBlock Grid.Column="0" Text="Work scale %" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="10" Maximum="100" Value="{Binding WorkScale, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding WorkScaleText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="How much of the frame the model sees while Boost is on" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Frame generation" FontSize="12" Foreground="#CBD5E1" />
                                        <TextBlock Text="Inserts generated frames between real ones." FontSize="11" Foreground="#A3AEC0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding FrameGeneration, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10" IsEnabled="{Binding FrameGeneration}">
                                    <TextBlock Grid.Column="0" Text="Frames x" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="2" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FrameMultiplier, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding FrameMultiplierText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="Motion" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Classes="GlassComboBox" ItemsSource="{Binding MotionBackendOptions}" SelectedIndex="{Binding SelectedMotionBackendIndex, Mode=TwoWay}" Height="34" HorizontalAlignment="Stretch" ToolTip.Tip="NVIDIA Optical Flow is faster where the driver offers it; it falls back to the CPU on its own." />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="Skip unchanged frames" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipStatic, Mode=TwoWay}" OnContent="" OffContent="" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="HDR capture" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Hdr, Mode=TwoWay}" OnContent="" OffContent="" ToolTip.Tip="For HDR screens. Restarts the capture." />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="Spout2 output" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Spout, Mode=TwoWay}" OnContent="" OffContent="" ToolTip.Tip="Publishes the processed picture to OBS and other Spout2 receivers. Restarts the capture." />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="Recording indicator" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding RecordingIndicator, Mode=TwoWay}" OnContent="" OffContent="" />
                                </Grid>

                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="Adapter" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="7" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NeuralScreenGpu, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding NeuralScreenGpuText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Adapter 0 is the first graphics card. Change it only if NeuralScreen picks the wrong one." FontSize="11" Foreground="#A3AEC0" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Height="1" Background="#24FFFFFF" Margin="0,3" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="CAPTURE TOOLS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Save screenshot" Click="OnScreenEngineScreenshotClicked" IsEnabled="{Binding IsRunning}" />
                                    <Button Content="{Binding RecordButtonText}" Click="OnScreenEngineRecordClicked" IsEnabled="{Binding IsRunning}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,100,Auto" ColumnSpacing="8" IsVisible="{Binding IsScreenEngine}">
                                    <ComboBox Grid.Column="0" Classes="GlassComboBox" ItemsSource="{Binding SweepOptions}" SelectedIndex="{Binding SelectedSweepIndex, Mode=TwoWay}" Height="34" />
                                    <NumericUpDown Grid.Column="1" Minimum="2" Maximum="50" Value="{Binding SweepValues, Mode=TwoWay}" Height="34" />
                                    <Button Grid.Column="2" Content="Run comparison sweep" Click="OnScreenEngineSweepClicked" IsEnabled="{Binding IsRunning}" />
                                </Grid>
                                <TextBlock Text="Capture folder" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0" Text="{Binding CaptureFolder, Mode=TwoWay}" Height="34" />
                                    <Button Grid.Column="1" Content="Browse" Click="OnScreenEngineCaptureFolderClicked" />
                                    <Button Grid.Column="2" Content="Open" Click="OnScreenEngineOpenCaptureFolderClicked" />
                                </Grid>
                                <TextBlock Text="Screenshots, recordings and sweep comparisons are saved here." FontSize="11" Foreground="#A3AEC0" TextWrapping="Wrap" />
                                <StackPanel Spacing="8" IsVisible="{Binding IsScreenEngine}">
                                <TextBlock Text="DLSS 5 model folder (nvngx_dlssnr.dll)" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0" Text="{Binding ModelFolder, Mode=TwoWay}" PlaceholderText="Bundled: mod files\dlss 5" Height="34" />
                                    <Button Grid.Column="1" Content="Browse" Click="OnScreenEngineModelFolderClicked" />
                                    <Button Grid.Column="2" Content="Use bundled" Click="OnScreenEngineBundledModelClicked" />
                                </Grid>
                                <TextBlock Text="Empty loads the DLL SUITE bundles. Pick another folder to try a different nvngx_dlssnr.dll; the bundled file is never changed." FontSize="11" Foreground="#A3AEC0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="#24FFFFFF" Margin="0,3" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="4" IsVisible="{Binding IsScreenEngine}">
                                    <TextBlock Text="Super resolution" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <ComboBox Classes="GlassComboBox" ItemsSource="{Binding SuperResolutionOptions}"
                                              SelectedIndex="{Binding SelectedSuperResolutionIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Height="34" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Compare with the original" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <ComboBox Classes="GlassComboBox" ItemsSource="{Binding CompareOptions}"
                                              SelectedIndex="{Binding SelectedCompareIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Height="34" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="12" IsVisible="{Binding IsScreenEngine}">
                            <Border Height="1" Background="#24FFFFFF" Margin="0,3" />
                            <ToggleButton Content="Advanced engine options" IsChecked="{Binding IsAdvancedOpen, Mode=TwoWay}" />
                            <StackPanel Spacing="10" IsVisible="{Binding IsAdvancedOpen}">
                                <TextBlock Text="MODEL" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="NR preset" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NrPresetSlider, Mode=TwoWay}" />
                                    <TextBox Grid.Column="2" Text="{Binding NrPresetText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Type any value, then press Tab or click away" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="SR preset" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SrPreset, Mode=TwoWay}" />
                                    <TextBox Grid.Column="2" Text="{Binding SrPresetText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Type any value, then press Tab or click away" />
                                </Grid>
                                <TextBlock Text="MOTION" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <ComboBox Grid.Column="0" Classes="GlassComboBox" ItemsSource="{Binding MotionOptions}" SelectedIndex="{Binding SelectedMotionIndex, Mode=TwoWay}" Height="34" />
                                    <ComboBox Grid.Column="1" Classes="GlassComboBox" ItemsSource="{Binding CursorOptions}" SelectedIndex="{Binding SelectedCursorIndex, Mode=TwoWay}" Height="34" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Skin follows structure" Foreground="#CBD5E1" VerticalAlignment="Center" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding SkinFollowsStructure, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10" IsVisible="{Binding !SkinFollowsStructure}"><TextBlock Grid.Column="0" Text="Skin strength" Foreground="#CBD5E1" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding SkinStrengthSlider, Mode=TwoWay}" /><TextBox Grid.Column="2" Text="{Binding SkinStrengthText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Type any value, then press Tab or click away" /></Grid>
                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="MV level" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="7" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MvLevel, Mode=TwoWay}" />
                                    <TextBox Grid.Column="2" Text="{Binding MvLevelText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Type any value, then press Tab or click away" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Set motion-vector scale manually" Foreground="#CBD5E1" VerticalAlignment="Center" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding UseManualMvScale, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding UseManualMvScale}"><TextBox Text="{Binding MvScaleX, Mode=TwoWay}" PlaceholderText="MV scale X" /><TextBox Grid.Column="1" Text="{Binding MvScaleY, Mode=TwoWay}" PlaceholderText="MV scale Y" /></Grid>
                                <Grid ColumnDefinitions="110,*,84" ColumnSpacing="10"><TextBlock Grid.Column="0" Text="Reset threshold" Foreground="#CBD5E1" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ResetThreshold, Mode=TwoWay}" /><TextBox Grid.Column="2" Text="{Binding ResetThresholdText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" MinHeight="30" MinWidth="0" Padding="6,4" FontSize="12" HorizontalContentAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Type any value, then press Tab or click away" /></Grid>
                                <TextBlock Text="CAPTURE AND WINDOW" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Capture border" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding CaptureBorder, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Keep output out of capture" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding Affinity, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Always on top" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding Topmost, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Click through output" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding ClickThrough, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Use redirection bitmap capture" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding RedirectionBitmap, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Exclude engine windows" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding ExcludeOwnWindows, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <TextBlock Text="NGX AND DIAGNOSTICS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><ComboBox Grid.Column="0" Classes="GlassComboBox" ItemsSource="{Binding NgxLogOptions}" SelectedIndex="{Binding SelectedNgxLogIndex, Mode=TwoWay}" Height="34" /><ComboBox Grid.Column="1" Classes="GlassComboBox" ItemsSource="{Binding LogLevelOptions}" SelectedIndex="{Binding SelectedLogLevelIndex, Mode=TwoWay}" Height="34" /></Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><TextBox Text="{Binding NgxAppId, Mode=TwoWay}" PlaceholderText="NGX app id (hex)" /><TextBox Grid.Column="1" Text="{Binding NgxProjectId, Mode=TwoWay}" PlaceholderText="NGX project id (GUID)" /></Grid>
                                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding AdapterOptions}" SelectedIndex="{Binding SelectedAdapterIndex, Mode=TwoWay}" Height="34" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Indicator" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding Indicator, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Kernel cache" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding CubinCache, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="D3D debug layer" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding DebugLayer, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Exclusion log" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding ExclusionLog, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="High-precision colour" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding HighPrecisionColour, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Show desktop-inert controls" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowInert, Mode=TwoWay}" OnContent="" OffContent="" /></Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding ShowInert}"><TextBlock Text="These options do not affect desktop capture in this engine build." Foreground="#A3AEC0" FontSize="11" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="UI correction" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding UiCorrection, Mode=TwoWay}" OnContent="" OffContent="" /></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="Depth inverted" Foreground="#CBD5E1" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding DepthInverted, Mode=TwoWay}" OnContent="" OffContent="" /></Grid><TextBox Text="{Binding DepthValue, Mode=TwoWay}" PlaceholderText="Depth value" /><ComboBox Classes="GlassComboBox" ItemsSource="{Binding NvofPerfOptions}" SelectedIndex="{Binding SelectedNvofPerfIndex, Mode=TwoWay}" Height="34" /><ComboBox Classes="GlassComboBox" ItemsSource="{Binding NvofGridOptions}" SelectedIndex="{Binding SelectedNvofGridIndex, Mode=TwoWay}" Height="34" /></StackPanel>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="VSync" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <ToggleSwitch IsChecked="{Binding VSync, Mode=TwoWay}" OnContent="" OffContent="" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Reset to defaults" Click="OnScreenEngineResetClicked" />
                            </Grid>

                            <TextBlock Text="Needs an NVIDIA RTX GPU and a driver with DLSS 5 support. Hotkeys while running: Ctrl+Alt+Shift+O original/processed, Ctrl+Alt+Shift+C split view, Ctrl+Alt+Shift+Q stop. Engine: Full-Screen Wrapper for DLSS5."
                                       TextWrapping="Wrap" Foreground="#A3AEC0" FontSize="11" />
                            </StackPanel>
                            <TextBlock IsVisible="{Binding IsNeuralScreen}" TextWrapping="Wrap" Foreground="#A3AEC0" FontSize="11" Text="NeuralScreen runs in the background; every change here applies to the picture straight away. Needs an RTX 30, 40 or 50 series card and a current NVIDIA driver. Passes run the model up to four times on its own result; each extra pass costs frame rate." />
                            <TextBlock IsVisible="{Binding IsNeuralScreen}" TextWrapping="Wrap" Foreground="#FBBF24" FontSize="11" Text="One-window capture in NeuralScreen needs the screen to be driven by the NVIDIA card. On laptops whose screen runs through the integrated GPU it can only process the whole screen - use the Screen Engine tab for a single window there." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Panel>
    </Border>
</Window>
