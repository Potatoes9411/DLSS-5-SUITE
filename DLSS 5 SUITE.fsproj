<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The installer lives in Setup/ as its own C# project. Keep the app from
         globbing it: Avalonia compiles every .axaml under a project folder, and
         the installer's windows are not part of the app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Setup\**;Tests\**;Engine\**</DefaultItemExcludes>
    <TargetFramework>net8.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AssemblyName>DLSS 5 SUITE</AssemblyName>
    <RootNamespace>DLSS_5_MANAGER</RootNamespace>

    <!-- Authorship, rights & version stamped into the executable's file details. -->
    <Product>DLSS 5 SUITE</Product>
    <AssemblyTitle>DLSS 5 SUITE</AssemblyTitle>
    <Company>Potatoes-dev</Company>
    <Authors>Potatoes9411</Authors>
    <Description>DLSS 5 SUITE � a modified version of DLSS 5 MANAGER (built by NODIX TECH, published by Numidia Studios). Built by Potatoes9411, published by Potatoes-dev.</Description>
    <Copyright>� 2026 Potatoes-dev. Based on DLSS 5 MANAGER, � 2026 Numidia Studios. All rights reserved.</Copyright>

    <!-- ================================================================= -->
    <!-- RUNTIME FOOTPRINT                                                  -->
    <!-- A desktop tool that sits idle most of the time, so the runtime is  -->
    <!-- tuned for a small resident set rather than for throughput.         -->
    <!-- ================================================================= -->
    <!-- Workstation GC: one heap instead of one per core. Server GC would
         reserve hundreds of megabytes on a modern CPU for no benefit here. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- No background GC thread and no extra heap headroom held for it. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Hand freed segments back to Windows instead of keeping them mapped,
         which is what keeps the number in Task Manager high after a scan. -->
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <!-- Re-JIT the paths that actually run hot; the rest stays at tier 0. -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The payload the installer deploys; must sit next to the built executable. -->
    <Content Include="mod files\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- UI translations, read at runtime. -->
    <Content Include="languages\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Models\GameItem.fs" />
    <Compile Include="Services\AppLog.fs" />
    <Compile Include="Services\DataMigration.fs" />
    <Compile Include="Services\Localization.fs" />
    <Compile Include="Services\ExtrasStore.fs" />
    <Compile Include="Services\GameAnalyzer.fs" />
    <Compile Include="Services\IconExtractor.fs" />
    <Compile Include="Services\GameScanner.fs" />
    <Compile Include="Services\GameLauncher.fs" />
    <Compile Include="Services\LosslessScalingDetector.fs" />
    <Compile Include="Services\VerifiedDownload.fs" />
    <Compile Include="Services\LosslessScalingInstaller.fs" />
    <Compile Include="Services\NeedForSpeedProfiles.fs" />
    <Compile Include="Services\GtaProfiles.fs" />
    <Compile Include="Services\GtaEnhancedInstaller.fs" />
    <Compile Include="Services\NonGameAppClassifier.fs" />
    <Compile Include="Services\ShaderGlassDetector.fs" />
    <Compile Include="Services\EmulatorCatalog.fs" />
    <Compile Include="Services\ModInstaller.fs" />
    <Compile Include="Services\ScreenEngine.fs" />
    <Compile Include="Services\NeuralScreen.fs" />
    <Compile Include="Services\RobloxShadeHost.fs" />
    <Compile Include="Services\AnalysisStore.fs" />
    <Compile Include="Services\UpdateChecker.fs" />
    <Compile Include="Services\SystemSpecs.fs" />
    <Compile Include="Services\CommunityApi.fs" />
    <Compile Include="ViewModels\ViewModelBase.fs" />
    <Compile Include="ViewModels\GameCardViewModel.fs" />
    <Compile Include="ViewModels\CommunityViewModel.fs" />
    <Compile Include="ViewModels\ScreenEngineViewModel.fs" />
    <Compile Include="ViewModels\MainViewModel.fs" />
    <Compile Include="Views\ScreenEngineWindow.axaml.fs" />
    <Compile Include="Views\MainWindow.axaml.fs" />
    <Compile Include="ViewLocator.fs" />
    <Compile Include="App.axaml.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <!-- ItemsRepeater left the core package in Avalonia 11. The games grid
         needs it: it is the only container that virtualises a wrapping
         layout, and without it every game in the library stays realised. -->
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- ================================================================= -->
  <!-- SOURCE PROTECTION                                                  -->
  <!-- Release builds are run through Obfuscar to rename the internal /   -->
  <!-- private surface (fields, methods, closures, helper types) so the   -->
  <!-- shipped assembly is hostile to decompilation. The public API is    -->
  <!-- kept intact because Avalonia XAML, ViewLocator and JSON resolve    -->
  <!-- those names at runtime (see Obfuscar.xml). Debug builds are never   -->
  <!-- touched, so day-to-day development and debugging stay clean.       -->
  <!-- ================================================================= -->
  <!--
    Runs after every Release build. Because the Publish target depends on Build,
    this fires before the publish pipeline copies files out, so the published
    (and self-contained / any-RID) assembly is obfuscated too. $(TargetDir) is
    RID-aware, so win-x86 / win-x64 output folders are handled automatically.
  -->
  <!--
    Obfuscation can be turned off with -p:SkipObfuscation=true. The bundled
    Obfuscar build targets .NET 9, so on a machine without that runtime the
    whole Release build fails on a step that only protects the output - which
    left no way to produce a build at all. The switch makes that a choice
    rather than a wall. Shipping builds should still run with it on.
  -->
  <Target Name="ObfuscateRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And '$(SkipObfuscation)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\obfuscate.ps1&quot; -Dir &quot;$(TargetDir.TrimEnd('\'))&quot; -Tool &quot;$(MSBuildProjectDirectory)\.obfuscar-tool\obfuscar.console.exe&quot;" />
  </Target>

  <!--
    Publish copies the primary assembly straight from obj\, bypassing the
    build-output copy above, so obfuscate the final published assembly too.
    This is the one that actually ships.
  -->
  <Target Name="ObfuscatePublish" AfterTargets="Publish" Condition="'$(SkipObfuscation)' != 'true'">
    <PropertyGroup>
      <_ObfPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)').TrimEnd('\'))</_ObfPublishDir>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\obfuscate.ps1&quot; -Dir &quot;$(_ObfPublishDir)&quot; -Tool &quot;$(MSBuildProjectDirectory)\.obfuscar-tool\obfuscar.console.exe&quot;" />
  </Target>
</Project>

